import Quickshell
import Quickshell.Io
import QtQuick.Layouts
import QtQuick

PanelWindow {
    anchors {
        top: true
        left: true
        right: true
    }

    color: "transparent"

    aboveWindows: false

    // implicitHeight: 18
    implicitHeight: 18

    RowLayout {
        spacing: 50
        anchors.centerIn: parent

        ClockWidget {
            anchors.centerIn: parent
        }
        Text {
            text: "Hola"
        }
    }
}
